{
  "name": "crinoid",
  "version": "0.1.0",
  "description": "Workspace for the crinoid package, scaffold, reference app, and tests.",
  "author": "Template Maintainers",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:package": "tsc --noEmit -p packages/crinoid/tsconfig.json",
    "typecheck:reference": "tsc --noEmit -p examples/reference-app/tsconfig.json",
    "test": "vitest run tests/unit tests/component",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "release:packages": "node scripts/release-packages.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "crinoid": "workspace:*",
    "electron": "^44.4.1",
    "jsdom": "^26.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
