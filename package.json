{
  "name": "electron-desktop-template",
  "productName": "Electron Desktop Template",
  "version": "0.1.0",
  "description": "Reusable Electron desktop application template.",
  "author": "Template Maintainers",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "build": "pnpm typecheck && electron-forge package",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests/unit tests/component tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --out-file src/renderer/locales/en/messages.json",
    "i18n:compile": "formatjs compile src/renderer/locales/en/messages.json --out-file src/renderer/locales/en/compiled.json",
    "i18n:verify": "formatjs compile src/renderer/locales/en/messages.json --ast",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "package": "electron-forge package",
    "make": "node scripts/incremental-make.mjs",
    "make:windows": "node scripts/incremental-make.mjs --platform win32 --arch x64",
    "make:macos": "node scripts/incremental-make.mjs --platform darwin --arch x64",
    "make:linux": "node scripts/incremental-make.mjs --platform linux --arch x64",
    "make:rpm": "node scripts/check-rpm.mjs && node scripts/incremental-make.mjs --platform linux --arch x64 --targets rpm",
    "make:appimage": "node scripts/check-appimage.mjs && node scripts/incremental-make.mjs --platform linux --arch x64 --targets AppImage",
    "publish": "electron-forge publish"
  },
  "dependencies": {
    "@formatjs/intl": "^6.1.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.1",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@reforged/maker-appimage": "^5.3.1",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@formatjs/cli": "^6.16.30",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
